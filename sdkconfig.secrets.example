# SPDX-License-Identifier: Apache-2.0
# Optional build-time presets: copy to sdkconfig.secrets (gitignored) and ./build.sh picks it up.
# A device flashed with these joins Wi-Fi straight away instead of starting the setup portal,
# and a factory reset returns to them. Leave the file out for normal (setup portal) builds.
CONFIG_WB_PRESET_SSID="HomeNet"
CONFIG_WB_PRESET_PASSWORD="change-me"
CONFIG_WB_PRESET_IP="192.168.1.250"
CONFIG_WB_PRESET_NETMASK="255.255.255.0"
CONFIG_WB_PRESET_GATEWAY="192.168.1.1"
CONFIG_WB_PRESET_ADMIN_PASSWORD="change-me"
# CONFIG_WB_PRESET_HOSTNAME="office-bridge"
